# Keep this project's dependencies inside backend/node_modules rather than
# hoisting into a parent that happens to sit above us in the filesystem.
link-workspace-packages=false

# workerd IS the Workers runtime and esbuild is the bundler. Both ship prebuilt
# platform binaries fetched by a postinstall script, so their builds must run or
# the runtime never starts.
#
# pnpm 11 treats un-approved build scripts as a HARD ERROR on every `pnpm run`,
# not just on install — so without this, every script in package.json fails
# before it starts. The approval list also lives in pnpm-workspace.yaml; this
# setting is what stops the check from erroring in a non-interactive shell
# (CI has no one to answer `pnpm approve-builds`).
strict-dep-builds=false
