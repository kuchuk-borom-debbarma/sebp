# ─────────────────────────────────────────────────────────────────────────────
# sebp-api — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never
# be committed.
#
# Local dev and tests load this via `--env-file .env.local`. Wrangler does NOT
# pick up `.env.local` automatically (only `.dev.vars`), which is why the dev
# and test scripts pass the flag explicitly. Verified during TASK-35.
#
# Everything here is read once at boot by src/config.ts, validated with Zod, and
# frozen. A missing or malformed value fails startup loudly rather than
# surfacing later as a strange runtime bug.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this is. Drives two boot guards:
#   - NOTIFIER_DRIVER=console is REFUSED in production (it prints live OTP codes)
#   - CORS_ALLOWED_ORIGINS=* is REFUSED in production
# One of: development | staging | production
ENVIRONMENT=development

# ── OTP ──────────────────────────────────────────────────────────────────────

# Number of digits in the code. 6 is the familiar default.
OTP_CODE_LENGTH=6

# How long a challenge stays valid, in seconds. Short is safer; too short
# generates support tickets when email is slow. 600 = 10 minutes.
OTP_EXPIRY_SECONDS=600

# Wrong guesses before the challenge is locked. Snapshotted onto each challenge
# at issue time, so changing this never retroactively locks out or unlocks a
# challenge already in flight.
OTP_MAX_ATTEMPTS=5

# SECRET. HMAC key for hashing OTP codes before storage.
# A 6-digit code has only 10^6 possibilities, so a bare hash is brute-forced in
# milliseconds — the pepper is what makes a database leak insufficient to
# recover live codes. Generate with: openssl rand -hex 32
# Never commit a real value. Never log it.
OTP_PEPPER=replace-me-with-openssl-rand-hex-32

# ── Notifications ────────────────────────────────────────────────────────────

# Which Notifier adapter to use.
#   console — prints the message (INCLUDING the OTP code) to stdout. Dev only.
#   pingram — real email/SMS delivery. Not implemented yet.
NOTIFIER_DRIVER=console

# ── Rate limiting ────────────────────────────────────────────────────────────
# An unrated OTP endpoint is free email for an attacker and a bill for you.

RATE_LIMIT_OTP_PER_EMAIL=3
RATE_LIMIT_OTP_PER_IP=10
RATE_LIMIT_OTP_WINDOW_SECONDS=3600

# ── Sessions ─────────────────────────────────────────────────────────────────

# SECRET. Signing key for better-auth. openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# Session lifetime in seconds. 604800 = 7 days.
SESSION_TTL_SECONDS=604800

# Cookie domain. In production set the PARENT domain (e.g. `.sebp.com`) so the
# SSR frontend on app.sebp.com and this API on api.sebp.com share one session.
# Leave EMPTY for local development — localhost rejects a domain attribute.
SESSION_COOKIE_DOMAIN=

# ── HTTP ─────────────────────────────────────────────────────────────────────

# Comma-separated allowed origins. Credentials are enabled (the session is a
# cookie), so `*` is not merely lax — it is refused outright in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Serve Swagger UI at /docs.
SWAGGER_ENABLED=true

# Minimum password length. Length beats composition rules; there is no
# uppercase/symbol requirement by design.
PASSWORD_MIN_LENGTH=10
