{
  "name": "sebp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env-file .env.local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sebp --local",
    "gates": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test:coverage",
    "test:coverage": "vitest run --coverage",
    "db:reset": "rm -rf .wrangler/state && echo 'local D1/KV/R2/Queue state destroyed'",
    "db:fresh": "pnpm db:reset && pnpm db:migrate:local",
    "db:shell": "wrangler d1 execute sebp --local --command",
    "types": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@better-auth/utils": "^0.5.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
